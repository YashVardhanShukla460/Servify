# ===========================
# Servify Environment Variables
# ===========================
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to Git.
# NEVER share your real credentials.
# ===========================


# --- SERVER ---

# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=

# JWT secret key (use a long random string)
JWT_SECRET=

# Node environment: development or production
NODE_ENV=development

# Port the Express server runs on
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173


# --- CLIENT (Frontend) ---
# Note: Vite requires all frontend env vars to start with VITE_

# Backend API URL (change to deployed URL in production)
VITE_API_URL=http://localhost:5000


# --- CLOUDINARY (Phase 17 - Image Uploads) ---
# Set these up when we reach Phase 17
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- RAZORPAY (Phase 19 - Payments) ---
# Set these up when we reach Phase 19
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
